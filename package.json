{
  "name": "pomasa-studio",
  "version": "0.1.0",
  "description": "POMASA Studio: manage all POMASA MASes (list, create via generator, run, inspect artifacts). DSH web-profile plugin.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "skill/",
    "pomasa-home/",
    "scripts/bundle-client.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/bundle-client.mjs",
    "verify": "node verify.mjs",
    "test:transport": "bash scripts/transport-smoke.sh",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "npm i -D @playwright/test && npx playwright install chromium",
    "prepare": "node scripts/bundle-client.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXtremeProgramming-cn/pomasa-studio.git"
  },
  "homepage": "https://github.com/eXtremeProgramming-cn/pomasa-studio",
  "bugs": {
    "url": "https://github.com/eXtremeProgramming-cn/pomasa-studio/issues"
  }
}
